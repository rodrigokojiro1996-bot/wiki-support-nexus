    {
      "id": 26,
      "type": "stat",
      "title": "Merges nos últimos 30 dias",
      "description": "Pull requests com merge feito nos últimos 30 dias (entre os 100 fechados mais recentes).",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/pulls",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "state",
                "value": "closed"
              },
              {
                "key": "sort",
                "value": "updated"
              },
              {
                "key": "direction",
                "value": "desc"
              },
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "{\"total\": $count($[merged_at and $toMillis(merged_at) > $millis() - 30 * 86400000])}",
          "columns": [
            {
              "selector": "total",
              "text": "total",
              "type": "number"
            }
          ]
        }
