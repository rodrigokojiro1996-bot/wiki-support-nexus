{
  "uid": "support-nexus-branches",
  "title": "Support Nexus · Branches do Git",
  "tags": [
    "support-nexus"
  ],
  "editable": true,
  "description": "Controle das branches enviadas ao GitHub: situação do PR, último push e histórico.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Painéis do Support Nexus",
      "type": "dashboards",
      "tags": [
        "support-nexus"
      ],
      "asDropdown": false,
      "includeVars": false
    },
    {
      "title": "Abrir o Support Nexus",
      "type": "link",
      "url": "http://localhost:8010",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 24,
      "type": "stat",
      "title": "Branches no GitHub",
      "description": "Branches que existem hoje no repositório (as apagadas depois do merge não contam).",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/branches",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "{\"total\": $count($)}",
          "columns": [
            {
              "selector": "total",
              "text": "total",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": "/^total$/"
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
