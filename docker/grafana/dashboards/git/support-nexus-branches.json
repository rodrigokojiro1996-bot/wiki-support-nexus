          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": "/^total$/"
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Último push",
      "description": "Quando foi o último envio de commits (git push) para qualquer branch.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/events",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "{\"total\": $toMillis($[type = \"PushEvent\"][0].created_at)}",
          "columns": [
            {
              "selector": "total",
              "text": "total",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": "/^total$/"
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 28,
      "type": "table",
      "title": "Branches",
      "description": "Toda branch que subiu: as que existem hoje, as que já tiveram PR (mesmo apagadas depois do merge) e as com push recente. Situação = o PR mais recente da branch; sem PR = subiu e ainda não pediu revisão. O GitHub só guarda os eventos de push dos últimos 90 dias.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/branches",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "$.{\"branch\": name, \"existe\": \"sim\", \"commit\": $substring(commit.sha, 0, 7)}",
          "columns": []
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "B",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/pulls",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "state",
                "value": "all"
              },
              {
                "key": "sort",
                "value": "created"
              },
              {
                "key": "direction",
                "value": "desc"
              },
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "($p := $; $distinct($p.head.ref).($r := $; $x := $p[head.ref = $r][0]; {\"branch\": $r, \"pr\": \"#\" & $string($x.number), \"titulo\": $x.title, \"situacao\": $x.merged_at ? \"merge feito\" : ($x.state = \"open\" ? \"PR aberto\" : \"PR fechado\"), \"autor\": $x.user.login, \"destino\": $x.base.ref}))",
          "columns": []
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "C",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/events",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "($e := $[type = \"PushEvent\"]; $distinct($e.payload.ref).($r := $; $x := $e[payload.ref = $r][0]; {\"branch\": $substringAfter($r, \"refs/heads/\"), \"ultimo_push\": $x.created_at, \"quem\": $x.actor.login}))",
          "columns": [
            {
              "selector": "ultimo_push",
              "text": "ultimo_push",
              "type": "timestamp"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "situacao"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PR aberto": {
                        "text": "PR aberto",
                        "color": "#3987e5"
                      },
                      "merge feito": {
                        "text": "merge feito",
                        "color": "#0ca30c"
                      },
                      "PR fechado": {
                        "text": "PR fechado",
                        "color": "#898781"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "sem PR",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ultimo_push"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "existe"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "apagada",
                        "color": "#898781"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Último push",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "branch",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "branch": "Branch",
              "situacao": "Situação",
              "pr": "PR",
              "titulo": "Título do PR",
              "autor": "Autor do PR",
              "destino": "Destino",
              "ultimo_push": "Último push",
              "quem": "Quem enviou",
              "commit": "Commit",
              "existe": "No GitHub"
            },
            "indexByName": {
              "branch": 0,
              "situacao": 1,
              "pr": 2,
              "titulo": 3,
              "autor": 4,
              "destino": 5,
              "ultimo_push": 6,
              "quem": 7,
              "commit": 8,
              "existe": 9
            },
            "excludeByName": {
              "link": true
            }
          }
        }
      ]
    },
    {
      "id": 29,
