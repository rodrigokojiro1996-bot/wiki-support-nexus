          {
            "displayName": "Quando",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "quando": "Quando",
              "branch": "Branch",
              "quem": "Quem enviou"
            },
            "indexByName": {
              "quando": 0,
              "branch": 1,
              "quem": 2
            },
            "excludeByName": {
              "link": true
            }
          }
        }
      ]
    },
    {
      "id": 30,
      "type": "bargauge",
      "title": "Pushes por branch",
      "description": "Quantos envios cada branch recebeu entre os últimos 100 eventos do repositório: onde o trabalho está acontecendo.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 14,
        "y": 16,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/events",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "($e := $[type = \"PushEvent\"]; $distinct($e.payload.ref).($r := $; {\"branch\": $substringAfter($r, \"refs/heads/\"), \"pushes\": $count($e[payload.ref = $r])}))",
          "columns": [
            {
              "selector": "pushes",
              "text": "pushes",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Nenhum push recente",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "top",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 26,
        "reduceOptions": {
          "calcs": [],
          "values": true,
          "fields": "/^pushes$/"
        }
      }
    },
