    {
      "id": 28,
      "type": "table",
      "title": "Branches",
      "description": "Toda branch que subiu: as que existem hoje, as que já tiveram PR (mesmo apagadas depois do merge) e as com push recente. Situação = o PR mais recente da branch; sem PR = subiu e ainda não pediu revisão. PR atualizado = último push ou comentário no PR. Último push vem do feed de eventos do GitHub, que atrasa algumas horas e guarda só 90 dias.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "github"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/branches",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "$map($, function($v) {{\"branch\": $v.name, \"existe\": \"sim\", \"commit\": $substring($v.commit.sha, 0, 7)}})",
          "columns": []
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "B",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/pulls",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "state",
                "value": "all"
              },
              {
                "key": "sort",
                "value": "created"
              },
              {
                "key": "direction",
                "value": "desc"
              },
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "$each($reduce($reverse($), function($a, $v) {$merge([$a, {$v.head.ref: $v}])}, {}), function($x, $r) {{\"branch\": $r, \"pr\": \"#\" & $string($x.number), \"titulo\": $x.title, \"situacao\": $x.merged_at ? \"merge feito\" : ($x.state = \"open\" ? \"PR aberto\" : \"PR fechado\"), \"autor\": $x.user.login, \"destino\": $x.base.ref, \"atualizado\": $x.updated_at}})",
          "columns": [
            {
              "selector": "branch",
              "text": "branch",
              "type": "string"
            },
            {
              "selector": "pr",
              "text": "pr",
              "type": "string"
            },
            {
              "selector": "titulo",
              "text": "titulo",
              "type": "string"
            },
            {
              "selector": "situacao",
              "text": "situacao",
              "type": "string"
            },
            {
              "selector": "autor",
              "text": "autor",
              "type": "string"
            },
            {
              "selector": "destino",
              "text": "destino",
              "type": "string"
            },
            {
              "selector": "atualizado",
              "text": "atualizado",
              "type": "timestamp"
            }
          ]
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "github"
          },
          "refId": "C",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://api.github.com/repos/rodrigokojiro1996-bot/wiki-support-nexus/events",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "per_page",
                "value": "100"
              }
            ]
          },
          "root_selector": "$each($reduce($reverse($[type = \"PushEvent\"]), function($a, $v) {$merge([$a, {$v.payload.ref: $v}])}, {}), function($x, $r) {{\"branch\": $substringAfter($r, \"refs/heads/\"), \"ultimo_push\": $x.created_at, \"quem\": $x.actor.login}})",
          "columns": [
            {
              "selector": "branch",
              "text": "branch",
              "type": "string"
            },
            {
              "selector": "ultimo_push",
              "text": "ultimo_push",
              "type": "timestamp"
            },
            {
              "selector": "quem",
              "text": "quem",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "situacao"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PR aberto": {
                        "text": "PR aberto",
                        "color": "#3987e5"
                      },
                      "merge feito": {
                        "text": "merge feito",
                        "color": "#0ca30c"
                      },
                      "PR fechado": {
                        "text": "PR fechado",
                        "color": "#898781"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "sem PR",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "atualizado"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ultimo_push"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "branch"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "titulo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "existe"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "apagada",
                        "color": "#898781"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "PR atualizado",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "branch",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "branch": "Branch",
              "situacao B": "Situação",
              "pr B": "PR",
              "titulo B": "Título do PR",
              "autor B": "Autor do PR",
              "destino B": "Destino",
              "atualizado B": "PR atualizado",
              "ultimo_push C": "Último push",
              "quem C": "Quem enviou",
              "commit A": "Commit",
              "existe A": "No GitHub"
            },
            "indexByName": {
              "branch": 0,
              "situacao B": 1,
              "pr B": 2,
              "titulo B": 3,
              "autor B": 4,
              "destino B": 5,
              "atualizado B": 6,
              "ultimo_push C": 7,
              "quem C": 8,
              "commit A": 9,
              "existe A": 10
            },
            "excludeByName": {
              "link": true
            }
          }
        }
      ]
    },
