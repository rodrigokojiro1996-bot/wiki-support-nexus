# credenciais e segredos (nunca versionar)
.env
coletor/.env
backend/ferramentas/segredos.txt

# curadoria e autores reais de quem usa o importador (no git ficam só os modelos .exemplo.json)
backend/ferramentas/curadoria.json
backend/ferramentas/curadoria_*.json
backend/ferramentas/autores.json

# dados gerados a partir de um banco real (estrutura interna; regenerar com o coletor)
coletor/saida/
prototipo/
backend/dados/
backend/modulos.json

# ambientes e dependências
coletor/.venv/
backend/.venv/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
__pycache__/
*.pyc

# editor / sistema
.vscode/
Thumbs.db
desktop.ini

# backend/seed/ guarda SÓ o sistema de exemplo; o importador grava o conteúdo real em backend/dados/.
# Reforço: qualquer manual ou print que não seja do exemplo fica fora do git mesmo se cair aqui por engano.
backend/seed/manuais/*
!backend/seed/manuais/DEMO.*.json
backend/seed/imagens/*
!backend/seed/imagens/.gitkeep
!backend/seed/imagens/DEMO.*/
