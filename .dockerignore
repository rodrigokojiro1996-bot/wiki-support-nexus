# O que NÃO vai para o contexto do build (docker build envia a pasta do projeto para o motor do Docker).
# Menos arquivos = build mais rápido; e nada sensível acaba dentro de uma imagem.

# git e editor
.git
.gitignore
.vscode
**/Thumbs.db
**/desktop.ini

# ambientes e dependências: a imagem instala as suas, travadas, do zero
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
frontend/dist
frontend/*.tsbuildinfo

# dados reais e segredos: nunca dentro da imagem (entram em tempo de execução, por volume)
backend/dados
backend/modulos.json
coletor/.env
.env
.env.*
coletor/saida
backend/ferramentas/segredos.txt
backend/ferramentas/curadoria.json
backend/ferramentas/curadoria_*.json
backend/ferramentas/autores.json
prototipo

# o que a imagem não usa
backend/tests
backend/ferramentas
coletor/tests
coletor/*.py
coletor/requirements.txt
docs
docker/prometheus
docker/grafana
*.ps1
pytest.ini
