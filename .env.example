# Copie para .env (na raiz do projeto, ao lado do docker-compose.yml) e troque os valores.
# O docker compose lê o .env sozinho. O .env real NÃO vai para o git.

# senha do usuário "admin" do Grafana (http://localhost:3000)
GRAFANA_SENHA=troque-esta-senha

# opcional: token do GitHub para o painel "Branches do Git" (sobe o limite de 60 para 5000 consultas por hora).
# Crie um fine-grained token SEM nenhuma permissão (só lê o que já é público): github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# fuso das datas gravadas (quem validou, quando). Padrão: America/Sao_Paulo
# NEXUS_FUSO=America/Sao_Paulo

# --- login com a conta Microsoft da empresa (Entra ID). Guia: docs/login-microsoft.md ---
# Só entram contas @farmaciasassociadas.com.br do tenant da empresa. Valores SEM aspas.
# true liga o login no app e, no servidor, tira a senha única do Caddy da frente do app (ela fica só no /grafana/).
MICROSOFT_AUTH_ENABLED=false
# MICROSOFT_TENANT_ID=     ID do diretório (tenant), um GUID. Nunca "common" nem "organizations"
# MICROSOFT_CLIENT_ID=     ID do aplicativo (cliente), um GUID
# MICROSOFT_CLIENT_SECRET= o "Valor" do segredo do cliente (não o "ID do segredo")
# MICROSOFT_REDIRECT_URI=  https://<domínio>/api/auth/retorno (igual ao cadastrado no Entra)

# --- só no servidor (Oracle Cloud): o deploy/oracle/configurar.sh preenche estas linhas ---
# NEXUS_DOMINIO=nexus-suporte.duckdns.org
# NEXUS_EMAIL=voce@exemplo.com
# NEXUS_ACESSO_USUARIO=equipe
# NEXUS_ACESSO_SENHA_HASH='$2a$14$...'      (gerado pelo configurar.sh; entre aspas simples por causa dos $)
# COMPOSE_FILE=docker-compose.yml:deploy/oracle/docker-compose.oracle.yml
