# Caddy na frente do Support Nexus no servidor (Oracle Cloud): HTTPS automático, senha na entrada e bloqueios.
# Valores vêm do .env (via deploy/oracle/docker-compose.oracle.yml). Guia: docs/oracle-cloud.md
{
	email {$NEXUS_EMAIL}   # aviso do Let's Encrypt se o certificado tiver problema
	admin off              # sem API de administração do Caddy
}

# Quem pode entrar. MICROSOFT_AUTH_ENABLED (no .env) escolhe um destes dois blocos, e é a MESMA variável que liga
# o login no app: um interruptor só, para nunca ficar o app sem senha e sem login. Use exatamente true ou false
# (outro valor e o Caddy não sobe: falha fechada).

# false (padrão): senha única da equipe (janela do navegador) na entrada de tudo. Não é o login do sistema: é um
# portão contra robôs e curiosos. Ficam abertos: /api/saude (monitores de disponibilidade) e /robots.txt (para os
# buscadores lerem o "não indexe" em vez de esbarrar na senha).
(login_microsoft_false) {
	@protegido not path /api/saude /robots.txt
	basic_auth @protegido {
		{$NEXUS_ACESSO_USUARIO} {$NEXUS_ACESSO_SENHA_HASH}
	}
}

# true: o app pede a conta Microsoft da empresa (docs/login-microsoft.md). A senha da entrada continua só no painel
# do Grafana, que não conhece o login Microsoft e mostra os painéis para quem passar dela.
(login_microsoft_true) {
	@grafana path /grafana /grafana/*
	basic_auth @grafana {
		{$NEXUS_ACESSO_USUARIO} {$NEXUS_ACESSO_SENHA_HASH}
	}
}

{$NEXUS_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# nunca vão para a internet: métricas (têm os nomes de quem contribuiu) e a documentação interativa da API
	@interno path /metrics /metrics/* /docs /docs/* /redoc /openapi.json
	respond @interno 404

	# senha na entrada ou login Microsoft: ver os dois blocos no começo do arquivo
	import login_microsoft_{$MICROSOFT_AUTH_ENABLED:false}

	# prints de até 8 MB (limite da API) com folga; acima disso o Caddy recusa antes de chegar na aplicação
	request_body {
		max_size 10MB
	}

	# painel do Grafana (opcional: deploy/oracle/docker-compose.grafana.yml). Sem o complemento, /grafana/ dá erro 502.
	# O Grafana não recebe a senha da entrada: senão tentaria usá-la como login dele.
	# (o Caddy tenta primeiro o reverse_proxy com caminho; o sem caminho fica para o resto)
	reverse_proxy /grafana* grafana:3000 {
		header_up -Authorization
	}

	reverse_proxy nexus:8010
}
